{
  "name": "@aqueduct/inlet",
  "version": "0.2.0",
  "description": "Portable webhook verification and ordered delivery into Aquifer",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
